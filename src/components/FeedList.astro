---
import { formatDate, toDateTimeAttr } from '../lib/dates';
import { withBase } from '../lib/paths';

interface Props {
	posts: Array<{
		id: string;
		data: {
			title: string;
			description: string;
			pubDate: Date;
		};
	}>;
}

const { posts } = Astro.props;
---

<ul class="feed">
	{
		posts.map((post) => (
			<li class="feed__item">
				<article>
					<h2 class="feed__title">
						<a href={withBase(`/posts/${post.id}`)}>{post.data.title}</a>
					</h2>
					<p class="feed__meta">
						<time datetime={toDateTimeAttr(post.data.pubDate)}>
							{formatDate(post.data.pubDate)}
						</time>
					</p>
					<p class="feed__description">{post.data.description}</p>
				</article>
			</li>
		))
	}
</ul>
