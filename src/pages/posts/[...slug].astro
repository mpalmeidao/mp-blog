---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostOutline from '../../components/PostOutline.astro';
import { formatDate, toDateTimeAttr } from '../../lib/dates';
import { buildOutline } from '../../lib/outline';
import { filterPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = filterPublishedPosts(
		await getCollection('posts'),
		import.meta.env.PROD,
	);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const outline = buildOutline(headings);
---

<Base title={post.data.title} description={post.data.description}>
	<div class="post-layout">
		<PostOutline items={outline} />
		<article class="post-article">
			<h1 class="page-title">{post.data.title}</h1>
			<p class="post-meta">
				<time datetime={toDateTimeAttr(post.data.pubDate)}>
					{formatDate(post.data.pubDate)}
				</time>
				{
					post.data.updatedDate && (
						<>
							{' '}
							· atualizado em{' '}
							<time datetime={toDateTimeAttr(post.data.updatedDate)}>
								{formatDate(post.data.updatedDate)}
							</time>
						</>
					)
				}
			</p>
			<div class="prose">
				<Content />
			</div>
		</article>
	</div>
</Base>
